rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!userDoc().data.keys().hasAny(['ativo']) || userDoc().data.ativo == true);
    }
    function hasRole(role) {
      return activeUser() && userDoc().data.role == role;
    }
    function managerOrAdmin() {
      return activeUser() && userDoc().data.role in ['gerente', 'administrador'];
    }
    function admin() {
      return hasRole('administrador');
    }

    // O usuário pode ler o próprio perfil mesmo quando inativo para que o app
    // detecte a desativação. Somente administrador ativo pode alterar perfis.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /sections/{id} {
      allow read: if activeUser();
      allow create, update, delete: if managerOrAdmin();
    }
    function autoCollectedEan(id) {
      return activeUser()
        && request.resource.data.keys().hasOnly(['ean','name','sectionId','unit','stock','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['ean','name','sectionId','unit','stock','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.ean is string
        && request.resource.data.ean.matches('^([0-9]{8}|[0-9]{13})$')
        && id == 'ean_' + request.resource.data.ean
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.sectionId == ''
        && request.resource.data.unit == 'UN'
        && request.resource.data.stock is number
        && request.resource.data.stock > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    match /products/{id} {
      allow read: if activeUser();
      // EANs novos podem ser incluídos automaticamente pela coleta, somente com dados mínimos e código como ID.
      allow create: if managerOrAdmin() || autoCollectedEan(id);
      allow delete: if managerOrAdmin();
      // A coleta pode atualizar o saldo e completar apenas nomes-placeholder de EAN.
      allow update: if managerOrAdmin() || (
        activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt', 'updatedBy', 'name'])
        && request.resource.data.keys().hasAll(['stock', 'updatedAt', 'updatedBy'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || (
          resource.data.ean is string
          && resource.data.name == 'Produto EAN ' + resource.data.ean
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 160
          && request.resource.data.name != resource.data.name
        ))
      );
    }
    match /counts/{id} {
      allow read: if managerOrAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if managerOrAdmin();
    }
    match /inventories/{id} {
      allow read: if managerOrAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if managerOrAdmin() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if managerOrAdmin();
    }
    // Auditoria: gerência e administrador consultam; usuários ativos registram
    // apenas eventos próprios. Os registros são imutáveis pelo aplicativo.
    match /auditLogs/{id} {
      allow read: if managerOrAdmin();
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['action','entityType','entityId','summary','details','userId','userEmail','role','createdAt'])
        && request.resource.data.keys().hasAll(['action','entityType','entityId','summary','details','userId','userEmail','role','createdAt'])
        && request.resource.data.action is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.summary is string
        && request.resource.data.details is map
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Mantido sem módulo visível no app; ainda protegido pela regra de perfil ativo.
    match /movements/{id} {
      allow read: if managerOrAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if managerOrAdmin() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if admin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}